#!/bin/sh
#
# Backend rpcd dla monitoringu modemow ZTE (MC888, MC7010, MC7510, ...).
# Rozmawia z modemem po HTTP, zwraca JSON dla widoku LuCI.
#
# DWA PROTOKOLY, jedno wyjscie:
#
#   goform - starsze API ZTE (/goform/goform_get_cmd_process), MC888, MC7010,
#            MF79U, MF297D;
#   ubus   - JSON-RPC pod /ubus/ na firmware zbudowanym na OpenWrt, MC7510.
#            Nazwy pol sa tam INNE, wiec odpowiedz przechodzi przez mapper
#            /usr/share/zte-modem/ubus-map.uc, ktory tlumaczy je na nazwy
#            goformowe. Dalej (cache, btsearch, widok) roznicy juz nie ma.
#
# Protokolu NIE zgadujemy z nazwy modelu - rozstrzyga, ktory endpoint odpowiada
# (patrz _detect_proto). Wynik ladunie w uci, zeby nie sprawdzac za kazdym razem.
#
# Zalozenia:
#  - tylko odczyt, zadnych operacji zapisu na modemie
#  - sesja jest REUZYWANA (modem dopuszcza jedna sesje admina naraz):
#    na goformie cookie, na ubusie token ubus_rpc_session
#  - odpowiedz jest cache'owana, zeby N otwartych kart LuCI = 1 zapytanie do modemu
#

. /usr/share/libubox/jshn.sh

CACHE="/tmp/zte-modem.json"
COOKIE="/tmp/zte-modem.cookie"
STOK="/tmp/zte-modem.stok"
LOCK="/tmp/zte-modem.lock"
BTS_CACHE="/tmp/zte-modem.bts"

# Mapper nazw pol dla protokolu ubus.
UBUS_MAP="/usr/share/zte-modem/ubus-map.uc"

# Sesja, ktorej jeszcze nie mamy. ubus wymaga tu 32 zer, nie pustego lancucha.
NULL_STOK="00000000000000000000000000000000"

BTS_API="https://btsearch.pl/api/v1/search"
BTS_LOOKUP="$(uci -q get zte-modem.main.bts_lookup)"; [ -n "$BTS_LOOKUP" ] || BTS_LOOKUP=1

HOST="$(uci -q get zte-modem.main.host)";                 [ -n "$HOST" ] || HOST="192.168.32.1"
PASSWORD="$(uci -q get zte-modem.main.password)"
INTERVAL="$(uci -q get zte-modem.main.refresh_interval)"; [ -n "$INTERVAL" ] || INTERVAL=10
TIMEOUT="$(uci -q get zte-modem.main.timeout)";           [ -n "$TIMEOUT" ] || TIMEOUT=6
VARIANT="$(uci -q get zte-modem.main.hash_variant)"
# Protokol modemu: goform | ubus | puste = wykryj i zapamietaj.
PROTO="$(uci -q get zte-modem.main.protocol)"

REFERER="http://${HOST}/index.html"

# Kolejnosc prob hashowania hasla. Ustalona wersja ladunie w uci (hash_variant),
# zeby kolejne logowania nie zgadywaly od nowa.
VARIANTS="sha256_b64 sha256_sha256 b64_plain md5_plain"

F="model_name,network_type,network_provider,signalbar,wan_ipaddr,ppp_status,modem_main_state"
F="${F},wa_inner_version,cr_version,simcard_roam,ussd_write_flag"
F="${F},lte_rsrp,lte_rsrq,lte_rssi,lte_snr,lte_pci,cell_id"
# MF297D nie wypelnia lte_snr ani lte_rssi - te same wielkosci podaje pod
# krotszymi nazwami `sinr` i `rssi`. Na MC888 jest odwrotnie, wiec obie pary
# pobieramy i widok bierze pierwsza niepusta.
F="${F},sinr,rssi"
F="${F},lte_ca_pcell_band,lte_ca_pcell_bandwidth,lte_ca_scell_band"
F="${F},lte_ca_scell_bandwidth,lte_ca_pcell_arfcn,wan_active_band"
# Pelna agregacja: "idx,PCI,?,pasmo,EARFCN,szerokosc" rozdzielone ';'.
# lte_ca_scell_* pokazuje tylko PIERWSZA nosna dodatkowa, a lte_ca_pcell_arfcn
# bywa puste - EARFCN PCell siedzi w lte_ca_pcell_freq.
F="${F},lte_multi_ca_scell_info,lte_ca_pcell_freq,enodeb_id,lte_band,wan_active_channel"
# Komorki sasiednie: "EARFCN,PCI,RSRQ,RSRP,RSSI" rozdzielone ';', PCI DZIESIETNE
# (tak samo jak w lte_multi_ca_scell_info, w odroznieniu od lte_pci). Pierwszy
# wpis to komorka obslugujaca - potwierdzone na MC888 i MC7010, gdzie zgadza sie
# z lte_pci i lte_ca_pcell_freq. Rozbior robi widok, tak jak dla CA.
F="${F},ngbr_cell_info"
# `bandwidth` (np. "15MHz") jest wypelnione TAKZE bez agregacji, gdy pola
# lte_ca_pcell_* sa puste - bez niego nie da sie policzyc sufitu na jednej nosnej.
F="${F},bandwidth"
F="${F},Z5g_rsrp,Z5g_rsrq,Z5g_SINR,Z5g_CELL_ID,nr5g_pci,nr5g_action_band,nr5g_action_channel"
F="${F},monthly_tx_bytes,monthly_rx_bytes,realtime_tx_thrpt,realtime_rx_thrpt"
# Limit transferu pilnowany przez sam modem. `data_volume_limit_size` jest
# zakodowane jako "<liczba>_<jednostka w MB>" ("1070_1024" = 1070 GiB) - rozbior
# robi widok, tak samo jak dla lte_multi_ca_scell_info. `..._unit` mowi, czy
# limit dotyczy danych ("data"), czy czasu polaczenia ("time").
F="${F},data_volume_limit_switch,data_volume_limit_size,data_volume_limit_unit"
F="${F},data_volume_alert_percent"
# Data najblizszego zerowania licznika (YYYYMMDD). Jedyne zrodlo - dnia miesiaca
# modem nie wystawia osobnym polem, choc ma go w ustawieniach ("Zresetuj licznik
# (dzien miesiaca)"). Sprawdzone: 8 w panelu -> date_month "20260908".
F="${F},date_month"
# Liczniki biezacego polaczenia (zeruja sie przy zestawieniu sesji PPP, w
# odroznieniu od monthly_*, ktore chodza wg cyklu rozliczeniowego modemu).
# Nie kazdy firmware je wypelnia - widok pomija sekcje, gdy sa puste.
F="${F},realtime_tx_bytes,realtime_rx_bytes"
# Tozsamosc urzadzenia, karty SIM i polaczenia - zakladka "Modem".
# Swiadomie NIE pobieramy msisdn, sim_card_status, sim_slot ani mac_address:
# sa puste na wszystkich trzech sprawdzonych modemach. Stan karty czytamy
# z modem_main_state. IMSI bywa tylko w sim_imsi (MC888, MC7010) - `imsi`
# wypelnia dopiero MF297D.
F="${F},imei,hardware_version,web_version,imsi,sim_imsi,iccid,pin_status"
F="${F},rmcc,rmnc,wan_apn,pdp_type,net_select_mode,realtime_time"
F="${F},ipv6_wan_ipaddr,lan_ipaddr"
FIELDS="$F"

#
# --- narzedzia -------------------------------------------------------------
#

_get() { # $1 = query string
	curl -s --max-time "$TIMEOUT" \
		-b "$COOKIE" -c "$COOKIE" \
		-H "Referer: ${REFERER}" \
		-H "X-Requested-With: XMLHttpRequest" \
		"http://${HOST}/goform/goform_get_cmd_process?$1" 2>/dev/null
}

# base64 przez ucode - haslo idzie przez srodowisko, NIE przez argv
# (argv widac w ps, srodowiska pojedynczego procesu nie)
_b64()     { ZTEPW="$1" ucode -e 'print(b64enc(getenv("ZTEPW")))' 2>/dev/null; }
_sha_up()  { printf '%s' "$1" | sha256sum | cut -d' ' -f1 | tr 'a-f' 'A-F'; }
_md5_lo()  { printf '%s' "$1" | md5sum    | cut -d' ' -f1; }

_hash() { # $1=wariant $2=haslo $3=LD
	local b64
	case "$1" in
		sha256_b64)    b64="$(_b64 "$2")"; _sha_up "${b64}${3}" ;;
		sha256_sha256) _sha_up "$(_sha_up "$2")${3}" ;;
		b64_plain)     _b64 "$2" ;;
		md5_plain)     _md5_lo "${2}${3}" ;;
	esac
}

#
# --- transport ubus (MC7510 i pokrewne) ------------------------------------
#
# JSON-RPC pod http://HOST/ubus/. Ksztalt wywolania:
#
#   [{"jsonrpc":"2.0","id":1,"method":"call",
#     "params":["<sesja>","<modul>","<metoda>",{<argumenty>}]}]
#
# a odpowiedzi:
#
#   [{"jsonrpc":"2.0","id":1,"result":[0,{<dane>}]}]          # sukces
#   [{"jsonrpc":"2.0","id":1,"error":{"code":-32002,...}}]    # brak sesji
#
# Zero w `result[0]` to status ubusa, dane siedza w `result[1]`.

_ub_post() { # $1 = tresc tablicy JSON-RPC
	curl -s --max-time "$TIMEOUT" \
		-H "Referer: http://${HOST}/" \
		-H "Content-Type: application/json" \
		-X POST "http://${HOST}/ubus/" \
		--data "$1" 2>/dev/null
}

_ub_call() { # $1=sesja $2=modul $3=metoda $4=argumenty JSON (domyslnie {})
	# Domyslne '{}' przez zmienna, a NIE przez ${4:-...}: w podstawieniu wewnatrz
	# cudzyslowow backslash przed nawiasem klamrowym zostaje w wyniku doslownie
	# ("\{\}"), czyli modem dostaje zepsuty JSON i odpowiada bledem.
	local args="$4"
	[ -n "$args" ] || args='{}'

	_ub_post "[{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"call\",\"params\":[\"$1\",\"$2\",\"$3\",$args]}]"
}

# Nazwy kluczy koperty, ktora dostaje mapper - W TEJ SAMEJ KOLEJNOSCI, co
# wywolania w _ub_batch. Mapper dopasowuje je po polu `id` odpowiedzi.
UBUS_KEYS="nwinfo,device,common,sim,iface,traffic,limit,apn,web"

# Wszystkie odczyty w JEDNYM zapytaniu HTTP.
#
# ubus przyjmuje TABLICE wywolan w jednym POST-cie - to odpowiednik goformowego
# multi_data=1. Sprawdzone na MC7510: dziewiec metod, jedna odpowiedz.
# Bez tego kazde odswiezenie to dziewiec round-tripow do modemu.
_ub_batch() { # $1 = sesja
	_ub_post "[
{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"call\",\"params\":[\"$1\",\"zte_nwinfo_api\",\"nwinfo_get_netinfo\",{}]},
{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"call\",\"params\":[\"$1\",\"zwrt_web\",\"device_info\",{}]},
{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"call\",\"params\":[\"$1\",\"zwrt_zte_mdm.api\",\"get_zwrt_common_info\",{}]},
{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"call\",\"params\":[\"$1\",\"zwrt_zte_mdm.api\",\"get_sim_info\",{}]},
{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"call\",\"params\":[\"$1\",\"zwrt_data\",\"get_wwaniface\",{\"source_module\":\"web\",\"cid\":1}]},
{\"jsonrpc\":\"2.0\",\"id\":6,\"method\":\"call\",\"params\":[\"$1\",\"zwrt_data\",\"get_wwandst\",{\"source_module\":\"web\",\"cid\":1,\"type\":4}]},
{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"call\",\"params\":[\"$1\",\"zwrt_data\",\"get_wwandst_monthlimit\",{\"source_module\":\"web\",\"cid\":1}]},
{\"jsonrpc\":\"2.0\",\"id\":8,\"method\":\"call\",\"params\":[\"$1\",\"zwrt_apn_object\",\"getCidApnList\",{\"cid\":1}]},
{\"jsonrpc\":\"2.0\",\"id\":9,\"method\":\"call\",\"params\":[\"$1\",\"zwrt_web\",\"web_info\",{}]}
]"
}

# Czy odpowiedz na paczke niesie dane, czy tylko "Access denied"?
#
# Sprawdzamy OBECNOSC obiektu result[1] pierwszego wywolania, a nie konkretnego
# pola: modem bez karty SIM oddaje nwinfo z mniejsza liczba pol, ale nadal
# oddaje obiekt. Brak `result` = brak sesji.
_ub_ok() { # $1 = odpowiedz
	[ -n "$(printf '%s' "$1" | jsonfilter -q -e '@[0].result[1]')" ]
}

# Logowanie: SHA256(SHA256(haslo) + sol), wszystko WIELKIMI literami hex.
#
# Sol (`zte_web_sault`, tak w oryginale) jest jednorazowa i przychodzi
# z web_login_info, ktory dziala BEZ sesji. To ten sam pomysl, co goformowe
# `cmd=LD`, tylko inna funkcja skrotu i inne opakowanie.
_ub_login() {
	local salt h1 h2 tok
	[ -n "$PASSWORD" ] || return 1

	rm -f "$STOK"

	salt="$(_ub_call "$NULL_STOK" zwrt_web web_login_info | \
		jsonfilter -q -e '@[0].result[1].zte_web_sault')"
	[ -n "$salt" ] || return 1

	h1="$(_sha_up "$PASSWORD")"
	h2="$(_sha_up "${h1}${salt}")"

	tok="$(_ub_call "$NULL_STOK" zwrt_web web_login "{\"password\":\"$h2\"}" | \
		jsonfilter -q -e '@[0].result[1].ubus_rpc_session')"
	[ -n "$tok" ] || return 1

	# Token daje pelny dostep do modemu - trzymamy go tak samo ciasno jak haslo.
	touch "$STOK" && chmod 600 "$STOK"
	printf '%s' "$tok" > "$STOK"

	# Zapisujemy wariant pod ta sama nazwa, co goformowe - to nadal jest sposob
	# hashowania hasla, a zakladka "Konfiguracja" czyta wlasnie to pole.
	if [ "$VARIANT" != "sha256_salt" ]; then
		uci -q set zte-modem.main.hash_variant="sha256_salt"
		uci -q commit zte-modem
	fi

	return 0
}

# Dane w konwencji goformu. Puste wyjscie = nie udalo sie.
#
# Najpierw probujemy zapamietanym tokenem i BEZ dodatkowego zapytania
# sprawdzajacego - jesli sesja zyje, jedno HTTP wystarcza na cale odswiezenie.
# Dopiero odmowa dostepu uruchamia logowanie. Modem trzyma sesje ~10 min
# bezczynnosci (login_timeout_lefttime), a domyslny interwal to 10 s, wiec
# w praktyce logujemy sie raz.
_ub_data() {
	local tok resp

	tok="$(cat "$STOK" 2>/dev/null)"

	if [ -n "$tok" ]; then
		resp="$(_ub_batch "$tok")"
		if _ub_ok "$resp"; then
			printf '%s' "$resp" | ZTE_UBUS_KEYS="$UBUS_KEYS" ucode -R "$UBUS_MAP"
			return 0
		fi
	fi

	_ub_login || return 1

	tok="$(cat "$STOK" 2>/dev/null)"
	resp="$(_ub_batch "$tok")"
	_ub_ok "$resp" || return 1

	printf '%s' "$resp" | ZTE_UBUS_KEYS="$UBUS_KEYS" ucode -R "$UBUS_MAP"
}

#
# --- wybor protokolu -------------------------------------------------------
#

# Czy odpowiada endpoint goformu?
#
# NIE wymagamy niepustego LD: MF79U zwraca puste (docs/modele.md), a i tak jest
# modemem goformowym. Wystarczy, ze endpoint oddaje JSON - MC7510 na tym adresie
# oddaje strone 404 w HTML-u, wiec te dwa przypadki rozroznia sie pewnie.
_gf_probe() {
	case "$(_get "isTest=false&cmd=LD")" in
		'{'*) return 0 ;;
	esac
	return 1
}

# Czy odpowiada endpoint ubusa? Rozpoznajemy po soli w web_login_info -
# to zadanie jest oddawane bez sesji, wiec test nie wymaga hasla.
_ub_probe() {
	[ -n "$(_ub_call "$NULL_STOK" zwrt_web web_login_info | \
		jsonfilter -q -e '@[0].result[1].zte_web_sault')" ]
}

# Wykrycie protokolu. Puste wyjscie = modem nie odpowiedzial na zaden z dwoch,
# czyli jest nieosiagalny - i wtedy WYNIKU NIE ZAPAMIETUJEMY, zeby chwilowy brak
# lacznosci nie zabetonowal w uci blednego protokolu.
_detect_proto() {
	_ub_probe && { echo ubus;   return 0; }
	_gf_probe && { echo goform; return 0; }
	return 1
}

_proto() {
	local p

	case "$PROTO" in
		goform|ubus) echo "$PROTO"; return 0 ;;
	esac

	p="$(_detect_proto)" || return 1

	uci -q set zte-modem.main.protocol="$p"
	uci -q commit zte-modem
	echo "$p"
}

# Czy mamy wazna sesje?
#
# UWAGA: NIE uzywac do tego `cmd=loginfo`. W formie POJEDYNCZEJ zwraca on
# {"loginfo":"ok"} takze BEZ cookie - sprawdzone na MC888. (W multi_data=1 to
# samo pole zachowuje sie juz poprawnie, ale roznica jest zbyt subtelna, zeby
# na niej polegac.) Opieranie sie na loginfo sprawia, ze modul nigdy sie nie
# loguje i wszystkie metryki sa puste.
#
# Jedyny wiarygodny test to odczyt pola, ktore modem oddaje wylacznie po
# zalogowaniu. Na czele `user_ip_addr` - jako jedyne jest wypelnione na
# wszystkich sprawdzonych modelach (MC888, MC7010, MF79U) i NIE zalezy od karty
# SIM ani od zestawionego polaczenia. Bez niego modem bez SIM-u wygladal na
# wylogowany przy kazdym odpytaniu i modul logowal sie w kolko, walczac
# o jedyna sesje z przegladarka uzytkownika.
#
# Reszta zostaje jako zapas na firmware, ktory user_ip_addr pomija.
_logged_in() {
	local v f

	v="$(_get "isTest=false&multi_data=1&cmd=user_ip_addr,lte_rsrp,Z5g_rsrp,cell_id,wan_ipaddr")"
	[ -n "$v" ] || return 1

	for f in user_ip_addr lte_rsrp Z5g_rsrp cell_id wan_ipaddr; do
		[ -n "$(printf '%s' "$v" | jsonfilter -q -e "@.$f")" ] && return 0
	done

	return 1
}

_login() { # $1 = wariant; 0 = sukces
	local ld hash res
	[ -n "$PASSWORD" ] || return 1

	rm -f "$COOKIE"
	ld="$(_get "isTest=false&cmd=LD" | jsonfilter -q -e '@.LD' 2>/dev/null)"
	[ -n "$ld" ] || return 1

	hash="$(_hash "$1" "$PASSWORD" "$ld")"
	[ -n "$hash" ] || return 1

	res="$(curl -s --max-time "$TIMEOUT" -b "$COOKIE" -c "$COOKIE" \
		-H "Referer: ${REFERER}" -H "X-Requested-With: XMLHttpRequest" \
		--data "isTest=false" \
		--data "goformId=LOGIN" \
		--data-urlencode "password=${hash}" \
		"http://${HOST}/goform/goform_set_cmd_process" 2>/dev/null \
		| jsonfilter -q -e '@.result' 2>/dev/null)"

	[ "$res" = "0" ]
}

# Loguje sie tylko gdy trzeba. Zwraca wariant przez echo, 0 = mamy sesje.
_ensure_session() {
	local v

	_logged_in && { echo "${VARIANT:-cached}"; return 0; }

	for v in ${VARIANT:-$VARIANTS}; do
		if _login "$v"; then
			if [ "$v" != "$VARIANT" ]; then
				uci -q set zte-modem.main.hash_variant="$v"
				uci -q commit zte-modem
			fi
			echo "$v"
			return 0
		fi
	done

	# Zapamietany wariant przestal dzialac (np. zmiana hasla) - sprobuj wszystkich.
	if [ -n "$VARIANT" ]; then
		for v in $VARIANTS; do
			[ "$v" = "$VARIANT" ] && continue
			if _login "$v"; then
				uci -q set zte-modem.main.hash_variant="$v"
				uci -q commit zte-modem
				echo "$v"
				return 0
			fi
		done
	fi

	return 1
}

#
# --- identyfikacja stacji bazowej (btsearch.pl) -----------------------------
#
# Modem podaje Cell ID szesnastkowo; btsearch szuka po dziesietnym ECI:
#   POST https://btsearch.pl/api/v1/search   {"query":"ecid: <dec>"}
#
# Wynik jest cache'owany w tmpfs pod numerem komorki - maszt zmienia sie rzadko,
# wiec to jedno zapytanie na zmiane komorki, a nie przy kazdym odswiezeniu.
# (Stary link `szukaj.php?mode=std&search=` juz nie dziala serwerowo: btsearch
# jest dzis SPA i kazdy adres zwraca ten sam szkielet HTML.)
#

# hex -> dec, z walidacja; puste wyjscie = wejscie nie bylo hexem
_hex2dec() {
	case "$1" in
		""|*[!0-9a-fA-F]*) return 1 ;;
	esac
	printf '%d' "0x$1" 2>/dev/null
}

# W jakim systemie modem podaje cell_id?
#
# Kodowanie rozni sie MIEDZY MODELAMI i MIEDZY POLAMI - nie ma pola, ktore by
# je oglaszalo. Rozstrzygamy zakresem: ECI ma 28 bitow (max 268435455).
#
# Przyklady zanonimizowane, ale arytmetycznie spojne (patrz docs/kodowanie-pol.md):
#
#   MC888   "21ab417"  -> litera        -> hex (0x21ab417 = 35304471)
#   MF79U   "0f2a1c"   -> litera        -> hex (993820; probka "0f2a16" daje ten sam
#                                          eNodeB 3882, przy sektorach 28 i 22)
#   MF297D  "35304501" -> hex = 892355841 > 268435455, czyli NIE ECI -> dec
#
# Ograniczenie: krotka wartosc bez liter, miesci sie w zakresie w obu
# interpretacjach (np. "1234567") - wygrywa hex. Dla 8-cyfrowych ECI
# dziesietnych test dziala, bo jako hex zawsze przekraczaja zakres.
_cell_base() { # $1=cell_id
	local c

	case "$1" in
		*[a-fA-F]*) echo hex; return ;;
	esac

	c="$(_hex2dec "$1")"
	[ -n "$c" ] && [ "$c" -gt 268435455 ] && { echo dec; return; }

	echo hex
}

# W jakim systemie modem podaje PCI? To OSOBNA decyzja niz cell_id - MF79U
# podaje cell_id szesnastkowo, a PCI dziesietnie ("205", jako hex 517, poza
# zakresem PCI 0-503). Seria MC podaje hex ("14f", "1e3"). Stad:
#
#   1. jest litera a-f      -> hex
#   2. jako hex > 503       -> to nie moze byc PCI -> dec
#   3. model MF79*          -> dec (MF79U potwierdzony)
#   4. inaczej              -> hex (zachowanie zgodne z seria MC)
#
# Punkt 3 jest potrzebny, bo dla wartosci typu "100" bez liter i w zakresie
# obu interpretacji sam lancuch nie rozstrzyga. Zawezony do MF79*, bo sama
# litera "MF" NIE oznacza rodziny: MF297D loguje sie jak seria MC
# (LD 64 hex, sha256_sha256), wiec z nazwy nie wynika nic pewnego.
_pci_base() { # $1=lte_pci $2=model_name
	local p

	case "$1" in
		*[a-fA-F]*) echo hex; return ;;
	esac

	p="$(_hex2dec "$1")"
	[ -n "$p" ] && [ "$p" -gt 503 ] && { echo dec; return; }

	case "$2" in
		MF79*|mf79*) echo dec; return ;;
	esac

	echo hex
}

_bts_fetch() { # $1 = ecid dziesietnie, $2 = plik cache
	local resp

	resp="$(curl -sS --max-time 8 -X POST "$BTS_API" \
		-H 'Content-Type: application/json' \
		-H 'Accept: application/json' \
		-d "{\"query\":\"ecid: $1\"}" 2>/dev/null)"

	# Pusta odpowiedz albo brak trafienia - nie cache'uj, sprobujemy pozniej.
	[ -n "$resp" ] || return 1
	[ -n "$(printf '%s' "$resp" | jsonfilter -q -e '@.data[0].station_id')" ] || return 1

	printf '%s' "$resp" > "$2"

	# Nie hoduj cache'a w nieskonczonosc przy skakaniu po komorkach.
	ls -t "${BTS_CACHE}".*.json 2>/dev/null | tail -n +21 | while read -r old; do
		rm -f "$old"
	done
}

#
# --- pobranie danych -------------------------------------------------------
#

_refresh() {
	local data variant authed=0 err="" now proto msg

	now="$(date +%s)"

	proto="$(_proto)" || proto=""

	if [ -z "$PASSWORD" ]; then
		err="Nie ustawiono hasla do modemu"
	elif [ -z "$proto" ]; then
		err="Modem nieosiagalny pod ${HOST}"
	elif [ "$proto" = "ubus" ]; then
		# Na ubusie BEZ sesji nie ma nic - kazda metoda odpowiada "Access
		# denied", wiec pobranie danych i logowanie to jedna operacja.
		data="$(_ub_data)"
		if [ -n "$data" ]; then
			authed=1
			variant="sha256_salt"
		else
			err="Logowanie do modemu nie powiodlo sie (sprawdz haslo)"
		fi
	else
		variant="$(_ensure_session)" && authed=1
		[ "$authed" -eq 1 ] || err="Logowanie do modemu nie powiodlo sie (sprawdz haslo)"
	fi

	# Na goformie czesc pol jest czytelna takze bez sesji, wiec pytamy zawsze -
	# nawet gdy logowanie sie nie udalo, cos jeszcze zobaczymy.
	[ "$proto" = "goform" ] && data="$(_get "isTest=false&multi_data=1&cmd=${FIELDS}")"

	if [ -z "$data" ]; then
		# Brak danych ma na ubusie DWIE przyczyny - modem nie odpowiada albo
		# odmowil logowania - i rozroznienie jest tu cala trescia komunikatu:
		# "sprawdz haslo" kieruje gdzie indziej niz "sprawdz kabel". Na goformie
		# odczyty przychodza takze bez sesji, wiec pusto znaczy tam brak
		# lacznosci i zostajemy przy komunikacie o nieosiagalnosci.
		msg="Modem nieosiagalny pod ${HOST}"
		[ "$proto" = "ubus" ] && [ -n "$err" ] && msg="$err"

		# Modem nieosiagalny - oddaj ostatnie znane dane, ale oznacz blad.
		if [ -s "$CACHE" ]; then
			json_init
			json_load_file "$CACHE" 2>/dev/null
			json_add_boolean "_stale" 1
			json_add_string  "_error" "$msg"
			json_dump
			return
		fi
		json_init
		json_add_string  "_error" "$msg"
		json_add_string  "_host" "$HOST"
		json_add_int     "_timestamp" "$now"
		json_add_boolean "_authenticated" 0
		json_dump
		return
	fi

	# --- identyfikatory i stacja bazowa ----------------------------------
	local cid pciv model pcibase cellbase dec f
	local bts_station="" bts_operator="" bts_city="" bts_addr=""
	local bts_lat="" bts_lon=""

	cid="$(printf '%s'   "$data" | jsonfilter -q -e '@.cell_id')"
	pciv="$(printf '%s'  "$data" | jsonfilter -q -e '@.lte_pci')"
	model="$(printf '%s' "$data" | jsonfilter -q -e '@.model_name')"
	# Na ubusie kodowanie jest ZNANE, nie wnioskowane: MC7510 podaje
	# identyfikatory dziesietnie. Potwierdzone trojako - cell_id 35072027
	# jako hex daloby 889438247, czyli poza 28-bitowe ECI; lte_pci 259 jako hex
	# to 601, poza zakres PCI 0-503; a PCI wewnatrz `lteca` jest dziesietne
	# i rowne lte_pci. Heurystyki z zakresu daja tu ten sam wynik, ale
	# przestaja dzialac dla malych wartosci (PCI "100" jest poprawne w obu
	# systemach), wiec skoro wiemy, to nie zgadujemy.
	if [ "$proto" = "ubus" ]; then
		pcibase="dec"
		cellbase="dec"
	else
		pcibase="$(_pci_base "$pciv" "$model")"
		cellbase="$(_cell_base "$cid")"
	fi

	# btsearch szuka po ECI dziesietnym - konwertujemy wg wykrytego kodowania.
	if [ "$BTS_LOOKUP" = "1" ] && [ -n "$cid" ]; then
		if [ "$cellbase" = "hex" ]; then
			dec="$(_hex2dec "$cid")"
		else
			dec="$cid"
		fi
		if [ -n "$dec" ]; then
			f="${BTS_CACHE}.${dec}.json"
			[ -s "$f" ] || _bts_fetch "$dec" "$f"
			if [ -s "$f" ]; then
				bts_station="$(jsonfilter -q -i "$f" -e '@.data[0].station_id')"
				bts_operator="$(jsonfilter -q -i "$f" -e '@.data[0].operator.name')"
				bts_city="$(jsonfilter -q -i "$f" -e '@.data[0].location.city')"
				bts_addr="$(jsonfilter -q -i "$f" -e '@.data[0].location.address')"
				bts_lat="$(jsonfilter -q -i "$f" -e '@.data[0].location.latitude')"
				bts_lon="$(jsonfilter -q -i "$f" -e '@.data[0].location.longitude')"
			fi
		fi
	fi

	json_init
	json_load "$data" 2>/dev/null
	json_add_string  "_host" "$HOST"
	json_add_int     "_timestamp" "$now"
	json_add_boolean "_authenticated" "$authed"
	json_add_boolean "_stale" 0
	json_add_string  "_variant" "${variant:-}"
	json_add_string  "_protocol" "${proto:-}"
	json_add_string  "_pci_base"  "$pcibase"
	json_add_string  "_cell_base" "$cellbase"
	[ -n "$dec" ]          && json_add_string "_cell_dec"     "$dec"
	[ -n "$bts_station" ]  && json_add_string "_bts_station"  "$bts_station"
	[ -n "$bts_operator" ] && json_add_string "_bts_operator" "$bts_operator"
	[ -n "$bts_city" ]     && json_add_string "_bts_city"     "$bts_city"
	[ -n "$bts_addr" ]     && json_add_string "_bts_address"  "$bts_addr"
	[ -n "$bts_lat" ]      && json_add_string "_bts_lat"      "$bts_lat"
	[ -n "$bts_lon" ]      && json_add_string "_bts_lon"      "$bts_lon"
	[ -n "$err" ] && json_add_string "_error" "$err"
	json_dump
}

_cache_age() {
	local ts now
	[ -s "$CACHE" ] || { echo 999999; return; }
	ts="$(jsonfilter -q -i "$CACHE" -e '@._timestamp' 2>/dev/null)"
	[ -n "$ts" ] || { echo 999999; return; }
	now="$(date +%s)"
	echo $(( now - ts ))
}

show_status() {
	local age

	age="$(_cache_age)"
	if [ "$age" -lt "$INTERVAL" ]; then
		cat "$CACHE"
		return
	fi

	# Serializacja: rownolegle wywolania nie mnoza zapytan do modemu.
	{
		flock -x 9

		age="$(_cache_age)"
		if [ "$age" -lt "$INTERVAL" ]; then
			cat "$CACHE"
		else
			# Bez 2>/dev/null - stderr ma byc widoczny przy diagnostyce
			# (`sh -x /usr/libexec/rpcd/zte-modem call status`).
			_refresh > "${CACHE}.new"
			if [ -s "${CACHE}.new" ]; then
				mv "${CACHE}.new" "$CACHE"
			else
				rm -f "${CACHE}.new"
			fi
			cat "$CACHE" 2>/dev/null || echo '{"_error":"Brak danych"}'
		fi
	} 9>"$LOCK"
}

# Diagnostyka: rozpoznaje protokol, wymusza logowanie i mowi, co zadzialalo.
#
# Wykrycie protokolu jest tu ZAPAMIETYWANE na nowo, bez ogladania sie na
# poprzedni wynik: to jedyne miejsce, w ktorym uzytkownik prosi wprost
# o sprawdzenie lacznosci, a modem pod tym adresem mogl sie zmienic.
show_probe() {
	local v ld ok="" proto

	json_init
	json_add_string "host" "$HOST"

	proto="$(_detect_proto)" || proto=""
	if [ -n "$proto" ]; then
		uci -q set zte-modem.main.protocol="$proto"
		uci -q commit zte-modem
	fi

	json_add_string  "protocol" "${proto:-}"
	json_add_boolean "reachable" "$([ -n "$proto" ] && echo 1 || echo 0)"

	# Wyzwanie z modemu. Na goformie to `cmd=LD`, na ubusie jednorazowa sol
	# z web_login_info - rozna nazwa, ta sama rola, wiec ta sama para pol
	# w wyniku (widok pokazuje dlugosc pod etykieta zalezna od protokolu).
	if [ "$proto" = "ubus" ]; then
		ld="$(_ub_call "$NULL_STOK" zwrt_web web_login_info | \
			jsonfilter -q -e '@[0].result[1].zte_web_sault')"
	elif [ "$proto" = "goform" ]; then
		ld="$(_get "isTest=false&cmd=LD" | jsonfilter -q -e '@.LD' 2>/dev/null)"
	fi

	json_add_string "ld" "${ld:-}"
	json_add_int    "ld_length" "${#ld}"

	if [ -z "$PASSWORD" ]; then
		json_add_string "error" "Nie ustawiono hasla do modemu"
		json_dump
		return
	fi

	if [ -z "$proto" ]; then
		json_add_boolean "success" 0
		json_add_string  "error" "Modem nieosiagalny pod ${HOST}"
		json_dump
		return
	fi

	if [ "$proto" = "ubus" ]; then
		# Na ubusie jest jeden sposob: SHA256(SHA256(haslo) + sol).
		json_add_array "tried"
		json_add_string "" "sha256_salt"
		json_close_array

		_ub_login && ok="sha256_salt"
	else
		json_add_array "tried"
		for v in $VARIANTS; do
			json_add_string "" "$v"
		done
		json_close_array

		for v in $VARIANTS; do
			if _login "$v"; then
				ok="$v"
				break
			fi
		done
	fi

	if [ -n "$ok" ]; then
		if [ "$VARIANT" != "$ok" ]; then
			uci -q set zte-modem.main.hash_variant="$ok"
			uci -q commit zte-modem
		fi
		json_add_string  "variant" "$ok"
		json_add_boolean "success" 1
	else
		json_add_boolean "success" 0
		json_add_string  "error" "Zaden wariant hashowania nie zadzialal"
	fi

	json_dump
}

case "$1" in
	list)
		json_init
		json_add_object "status"
		json_close_object
		json_add_object "probe"
		json_close_object
		json_dump
		;;
	call)
		case "$2" in
			status) show_status ;;
			probe)  show_probe  ;;
		esac
		;;
esac

exit 0

config zte-modem 'main'
	# Adres modemu. UWAGA: to NIE jest adres routera, na ktorym stoi ten modul.
	option host '192.168.32.1'
	# Haslo administratora modemu. Puste = uzupelnij w LuCI (nie trzymamy go w repo).
	option password ''
	# Co ile sekund odpytywac modem (5-300). Chroni tez przed zalewaniem modemu,
	# gdy otwartych jest kilka kart LuCI naraz.
	option refresh_interval '10'
	# Timeout pojedynczego zapytania HTTP do modemu.
	option timeout '6'
	# Wykryty wariant hashowania hasla - ustawiany automatycznie, nie ruszac recznie.
	option hash_variant ''
	# Protokol modemu: 'goform' (MC888, MC7010, MF79U, MF297D) albo 'ubus'
	# (MC7510). Puste = wykryj przy pierwszym odczycie i zapamietaj. Wykrycie
	# powtarza przycisk "Sprawdz logowanie" na zakladce Konfiguracja, wiec przy
	# podmianie modemu nie trzeba tego czyscic recznie.
	option protocol ''
	# Rozpoznawanie stacji bazowej przez API btsearch.pl (wysyla Cell ID na zewnatrz).
	# 0 = wylacz, jesli nie chcesz odpytywac zewnetrznego serwisu.
	option bts_lookup '1'
